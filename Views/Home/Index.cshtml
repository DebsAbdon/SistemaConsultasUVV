@{
    ViewData["Title"] = "Sistema de Consultas UVV";
}

<div class="text-center mt-5">
    <h1 class="display-4">Sistema de Gestão de Consultas UVV</h1>

    <p class="lead mt-3">
        Gerencie seus usuários e consultas de forma simples e segura.
    </p>

    <div class="mt-4">
        <a asp-controller="Usuario"
           asp-action="Cadastro"
           class="btn btn-primary me-2">
            Criar conta
        </a>

        <a asp-controller="Usuario"
           asp-action="Login"
           class="btn btn-success">
            Entrar
        </a>
    </div>
</div>
