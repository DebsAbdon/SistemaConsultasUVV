@model IEnumerable<SistemaConsultasUVV.Models.Consulta>

@{
    ViewData["Title"] = "Minhas Consultas";
}

<h1>Minhas Consultas</h1>

<p>
    <a asp-controller="Consulta"
       asp-action="Cadastro"
       class="btn btn-primary">
        Nova Consulta
    </a>
</p>

@if (!Model.Any())
{
    <p>Você ainda não possui consultas cadastradas.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Especialidade</th>
                <th>Data e Hora</th>
                <th>Descrição</th>
                <th>Ações</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var consulta in Model)
            {
                <tr>
                    <td>@consulta.Especialidade</td>
                    <td>@consulta.DataHora.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@consulta.Descricao</td>
                    <td>
                        <a asp-action="Editar"
                           asp-route-id="@consulta.Id"
                           class="btn btn-warning">
                            Editar
                        </a>

                        <form asp-action="Excluir"
                              asp-route-id="@consulta.Id"
                              method="post"
                              style="display:inline;">
                            <button type="submit"
                                    class="btn btn-danger"
                                    onclick="return confirm('Deseja realmente excluir esta consulta?');">
                                Excluir
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
